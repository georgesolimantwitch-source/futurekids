# Google Play Billing (Earnly Android — server verification + RTDN)
# Service account JSON email + private key (never ship these in the Android app).
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME_EARNLY=com.earnly.family
# Freshys Android package (placeholder until Play Billing is connected)
GOOGLE_PLAY_PACKAGE_NAME_FRESHER=com.fresher.app
# Full HTTPS URL of the RTDN push endpoint (must match Pub/Sub push subscription audience).
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://kidsfuture.vercel.app/api/subscriptions/google/rtdn
# Optional: restrict OIDC tokens to the Pub/Sub push service account email.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

